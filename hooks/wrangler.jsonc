{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Generic ingress Worker — not linked from the public artist site.
  "name": "rrsm-hooks",
  "main": "src/index.js",
  "compatibility_date": "2026-07-24",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  // Custom domain + explicit route so we beat the site catch-all *.domain/*
  "routes": [
    {
      "pattern": "hooks.riverraisedsouthernmade.com",
      "custom_domain": true
    },
    {
      "pattern": "hooks.riverraisedsouthernmade.com/*",
      "zone_name": "riverraisedsouthernmade.com"
    }
  ]
}
